# 可选：复制为项目目录下的 .env，再按 NAS 实际目录的所属用户调整。
# 登录用户名和密码请直接修改 docker-compose.yaml 中的 MEDIA_USER / MEDIA_PASS。
PUID=10001
PGID=10001

# 可选：容器内应用使用的代理，留空则不通过这里设置。
# 需要代理时填写 NAS/容器可访问的地址，并在代理端允许局域网连接。
PROXY_URL=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,media-index,pansou,quark-auto-save,openlist
